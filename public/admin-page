<!doctype html>
<html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no"><meta name="color-scheme" content="light"><title>管理面板</title><link rel="icon" type="image/webp" sizes="400x400" href="/favicon.webp"><link rel="icon" type="image/png" sizes="400x400" href="/favicon.png"><link rel="stylesheet" href="/css/style.css?v=20261109-auth-6"></head>
<body><div class="lang-wrap" id="auth-lang-wrap" hidden><button class="btn" type="button" tabindex="-1" aria-hidden="true"><span class="language-glyph" aria-hidden="true"><span>文</span><small>A</small></span></button><select class="lang-select" id="auth-lang-select" aria-label="翻译"><option value="zh">中文</option><option value="en">English</option><option value="fa">فارسی</option></select></div><main>
<dialog id="option-dialog"><div class="dialog-heading"><h2 id="option-title" data-i18n="dlg_add_option">添加选项</h2><button id="option-close" type="button" aria-label="关闭">×</button></div><div class="field"><span data-i18n="dlg_name">备注</span><input id="option-name" aria-label="备注" data-i18n-ph="ph_remark" placeholder="填写备注"></div><div class="field"><span data-i18n="dlg_url">URl</span><input id="option-url" aria-label="URl" type="url" placeholder="https://..."></div><button id="option-save" type="button" data-i18n="save" onclick="saveOption()">保存</button></dialog>
<dialog id="edit-dialog"><div class="dialog-heading"><h2 id="edit-title" data-i18n="dlg_edit_self">编辑自用订阅</h2><button id="edit-close" type="button" aria-label="关闭">×</button></div><div class="field"><span data-i18n="dlg_link_name">链接名称</span><input id="edit-name" aria-label="链接名称" maxlength="80" data-i18n-ph="ph_self_name" placeholder="例如：我的主订阅"></div><p class="select-title">SUBAPI</p><select id="edit-backend" aria-label="SUBAPI"></select><div class="select-url" id="edit-backend-url"></div><p class="select-title">SUBCONFIG</p><select id="edit-rule" aria-label="SUBCONFIG"></select><div class="select-url" id="edit-rule-url"></div><p class="select-title" data-i18n="sec_groups">订阅分组</p><div id="edit-groups" class="group-pick"></div><div class="path-heading"><span data-i18n="dlg_link_path">订阅链接路径</span><button id="edit-random-path" type="button" data-i18n="random_uuid">随机UUID</button></div><input id="edit-path" aria-label="订阅链接路径" maxlength="128" data-i18n-ph="ph_path_hint" placeholder="留空自动生成 UUID"><p class="select-url" id="edit-path-hint" data-i18n="hint_path">留空自动生成 UUID；可直接输入自定义路径，或点击按钮反复生成。</p><div class="link-actions"><button id="edit-save" type="button" data-i18n="save_edit">保存修改</button></div></dialog>
<dialog id="group-dialog"><div class="dialog-heading"><h2 id="group-title" data-i18n="dlg_add_group">添加分组</h2><button id="group-close" type="button" aria-label="关闭">×</button></div><div class="field"><span data-i18n="dlg_group_name">分组名称</span><input id="group-name" aria-label="分组名称" maxlength="80" data-i18n-ph="ph_group_name" placeholder="例如：Fam"></div><p class="select-title" data-i18n="dlg_group_src">上游链接</p><textarea id="group-input" aria-label="上游链接" data-i18n-ph="ph_group_src" placeholder="每行一个订阅地址"></textarea><p><button id="group-save" type="button" data-i18n="save">保存</button></p></dialog>
<section id="auth-panel" hidden><h2 id="auth-title" data-i18n="site_account">管理员账号设置</h2><div class="field"><span data-i18n="admin_user">管理员账号</span><input id="account" aria-label="管理员账号" autocomplete="username" placeholder="admin" required></div><div class="field"><span data-i18n="admin_pass">管理员密码</span><input id="password" aria-label="管理员密码" type="password" autocomplete="new-password" minlength="8" required></div><button id="auth-submit" type="button" data-i18n="save">保存</button></section>
<div id="admin-content" hidden><span id="topbar-title">订阅</span><div id="title-divider"></div>
<header class="topbar"><div class="topbar-inner"><div class="topbar-controls"><div class="topbar-home"><a class="btn" href="/" data-i18n="nav_home">首页</a></div><div class="topbar-navigation"><div class="nav-capsule"><span class="navigation-indicator" aria-hidden="true"></span><nav class="nav" aria-label="管理面板导航"><a href="#" data-tab="subscribe" draggable="false" aria-current="page" data-i18n="nav_sub">订阅</a><a href="#" data-tab="data" draggable="false" data-i18n="nav_data">数据</a><a href="#" data-tab="config" draggable="false" data-i18n="nav_config">配置</a><a href="#" data-tab="site" draggable="false" data-i18n="nav_site">站点</a></nav></div></div><div class="topbar-actions"><div class="lang-wrap" id="lang-wrap"><button class="btn" type="button" tabindex="-1" aria-hidden="true"><span class="language-glyph" aria-hidden="true"><span>文</span><small>A</small></span></button><select class="lang-select" id="lang-select" aria-label="翻译"><option value="zh">中文</option><option value="en">English</option><option value="fa">فارسی</option></select></div></div></div></div></header>
<section class="tab-panel" id="panel-subscribe"><h1 data-i18n="nav_sub">订阅</h1>
<div class="setting-card"><div class="sec-head"><p class="select-title" data-i18n="sec_groups">订阅分组</p><button id="add-group" type="button" data-i18n="add_group">添加分组</button></div><ul id="group-list"></ul></div>
<div class="setting-card"><div class="sec-head"><p class="select-title" data-i18n="sec_self">自用订阅</p><button id="add-self" type="button" data-i18n="add_self">添加订阅</button></div><ul id="self-list"></ul></div>
</section>
<section class="tab-panel" id="panel-data" hidden><h1 data-i18n="nav_data">数据</h1><div class="setting-card"><div class="sec-head"><p class="select-title" data-i18n="sec_backup">备份与迁移</p><span class="sec-actions"><button id="export-data" type="button" data-i18n="export_btn">导出</button><button id="import-data-button" type="button" data-i18n="import_btn">导入</button><button id="clear-data" type="button" class="btn-danger" data-i18n="clear_btn">清空数据</button></span></div><input id="import-data" type="file" accept="application/json,.json" aria-label="导入备份" hidden></div><div class="setting-card"><div class="sec-head"><p class="select-title" data-i18n="sec_links">订阅链接</p></div><ul id="all-links"></ul></div></section>
<section class="tab-panel" id="panel-config" hidden><h1 data-i18n="nav_config">配置</h1>
<div class="setting-card"><div class="field"><div class="select-row"><span data-i18n="def_backend">默认 SUBAPI</span><select id="default-backend" aria-label="默认 SUBAPI"></select></div><div class="select-url" id="default-backend-url"></div></div></div><div class="setting-card"><div class="sec-head"><p class="select-title" data-i18n="list_backend">SUBAPI列表</p><button id="add-backend" type="button" data-i18n="add_backend">添加 SUBAPI</button></div><ul id="backend-list"></ul></div>
<div class="setting-card"><div class="field"><div class="select-row"><span data-i18n="def_rule">默认 SUBCONFIG</span><select id="default-subconfig" aria-label="默认 SUBCONFIG"></select></div><div class="select-url" id="default-subconfig-url"></div></div></div><div class="setting-card"><div class="sec-head"><p class="select-title" data-i18n="list_rule">SUBCONFIG列表</p><button id="add-subconfig" type="button" data-i18n="add_rule">添加规则选项</button></div><ul id="subconfig-list"></ul></div>
</section>
<section class="tab-panel" id="panel-site" hidden><h1 data-i18n="nav_site">站点</h1><div class="site-card"><div class="field"><span data-i18n="site_path">管理面板路径</span><input id="site-admin-path" aria-label="管理面板路径" placeholder="/admin"></div><button id="save-admin-path" type="button" data-i18n="save_path">保存路径</button></div><div class="site-card"><div class="field"><span data-i18n="site_title">首页标题</span><input id="site-home-title-zh" aria-label="中文标题" placeholder="订阅转换"></div><div class="field"><span>English</span><input id="site-home-title-en" aria-label="English title" placeholder="Subscription Converter"></div><div class="field"><span>فارسی</span><input id="site-home-title-fa" aria-label="عنوان فارسی" placeholder="تبدیل اشتراک"></div><button id="save-home-title" type="button" data-i18n="save_title">保存标题</button></div><div class="site-card"><div class="field"><span data-i18n="site_icon">网站图标</span><input id="site-icon-url" aria-label="网站图标链接" placeholder="/favicon.webp"></div><button id="save-site-icon" type="button" data-i18n="save_icon">保存图标</button></div><div class="site-card"><div class="field"><span data-i18n="admin_user">管理员账号</span><input id="site-account" aria-label="管理员账号"></div><div class="field"><span data-i18n="new_pass">新密码（至少 8 位）</span><input id="site-password" type="password" aria-label="新密码" minlength="8" autocomplete="new-password"></div><button id="save-site" type="button" data-i18n="save_account">保存账号密码</button></div></section>
</div>
</main><script src="/js/toast.js?v=20261109-toast-6"></script>
<script src="/js/i18n.js?v=20261111-mobile-2"></script>
<script src="/js/admin.js?v=20261110-expiry-gray-1"></script></body></html>
